--!strict
-- Writes src/shared/StyleTest/MotionPaths.luau from the baked motion study (tools/animation/baked/motion-study.json):
-- each vault clip's root path (lift above the start, forward distance; root space, 30 fps), the obstacle height it was
-- baked over and how far ahead its face was at the start, for MoveTest to carry the root along while the clip plays.
-- usage: lune run tools/animation/paths.luau
local fs = require("@lune/fs")
local serde = require("@lune/serde")

local data = serde.decode("json", fs.readFile("tools/animation/baked/motion-study.json"))
local lines = {
	"--!strict",
	"-- GENERATED by tools/animation/paths.luau from the baked motion study; do not edit.",
	"-- Vault clips' root paths: { lift, forward } per frame at 30 fps (studs above the start, studs ahead along the look).",
	"return {",
}
for _, c in data.clips do
	if c.path then
		local pts = {}
		for _, p in c.path do
			table.insert(pts, string.format("{ %.3f, %.3f }", p[1], -p[2]))
		end
		table.insert(lines, string.format("\t%s = {", c.name))
		table.insert(lines, string.format("\t\theight = %s,", tostring(c.height)))
		table.insert(
			lines,
			string.format(
				"\t\ttrigger = %s, -- the face this far ahead of the root at the start",
				tostring(c.trigger)
			)
		)
		table.insert(lines, "\t\tfps = 30,")
		table.insert(lines, "\t\tpath = { " .. table.concat(pts, ", ") .. " },")
		table.insert(lines, "\t},")
	end
end
table.insert(lines, "}")
fs.writeFile("src/shared/StyleTest/MotionPaths.luau", table.concat(lines, "\n") .. "\n")
print("wrote src/shared/StyleTest/MotionPaths.luau")
